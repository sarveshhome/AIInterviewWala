# ===== App =====
APP_NAME=AI Interview Coach
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# ===== MongoDB =====
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/ai_interview_coach
MONGODB_DB=ai_interview_coach

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== JWT =====
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ===== Cohere =====
COHERE_API_KEY=your-cohere-api-key-here
COHERE_MODEL=command-r-plus
COHERE_EMBED_MODEL=embed-english-v3.0

# ===== OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ===== Rate Limit =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute

# ===== Observability =====
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-interview-coach
LOG_LEVEL=INFO